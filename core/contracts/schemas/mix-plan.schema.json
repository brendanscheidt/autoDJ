{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autodj.mix-plan.v1",
  "title": "AutoDJ MixPlan v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "planId",
    "createdAtUtc",
    "strategy",
    "tracks",
    "transitions",
    "commands"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "createdAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "strategy": {
      "$ref": "#/$defs/strategyProvenance"
    },
    "tracks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trackPlacement"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trackAssetReference"
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transitionEdge"
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deckCommand"
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/planAnnotation"
      }
    }
  },
  "$defs": {
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "bpm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "timeSeconds": {
      "type": "number",
      "minimum": 0
    },
    "tempoPlan": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "sourceBpm": {
          "$ref": "#/$defs/bpm"
        },
        "targetBpm": {
          "$ref": "#/$defs/bpm"
        },
        "tempoRatio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "preservePitch": {
          "type": "boolean"
        },
        "backend": {
          "type": "string",
          "minLength": 1
        },
        "backendVersion": {
          "type": "string"
        },
        "quality": {
          "type": "string"
        },
        "renderedSourceUri": {
          "type": "string"
        },
        "renderedContentHash": {
          "type": "string"
        },
        "targetBpmBias": {
          "type": "number"
        },
        "validatedBpm": {
          "$ref": "#/$defs/bpm"
        },
        "validationStatus": {
          "enum": [
            "not_required",
            "pending",
            "passed",
            "warning",
            "failed"
          ]
        },
        "requiresRenderedBpmValidation": {
          "type": "boolean"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "strategyProvenance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "strategyId",
        "strategyVersion"
      ],
      "properties": {
        "strategyId": {
          "type": "string",
          "minLength": 1
        },
        "strategyVersion": {
          "type": "string",
          "minLength": 1
        },
        "randomSeed": {
          "type": "string"
        }
      }
    },
    "trackAssetReference": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "trackId",
        "sourceUri"
      ],
      "properties": {
        "trackId": {
          "type": "string",
          "minLength": 1
        },
        "sourceUri": {
          "type": "string",
          "minLength": 1
        },
        "formatHint": {
          "enum": [
            "wav",
            "mp3",
            "flac",
            "aiff",
            "unknown"
          ]
        },
        "contentHash": {
          "type": "string"
        },
        "durationSeconds": {
          "$ref": "#/$defs/timeSeconds"
        },
        "sourceBpm": {
          "$ref": "#/$defs/bpm"
        },
        "normalizedBpm": {
          "$ref": "#/$defs/bpm"
        }
      }
    },
    "trackPlacement": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "placementId",
        "trackId",
        "deck",
        "sourceStartSeconds",
        "timelineStartSeconds"
      ],
      "properties": {
        "placementId": {
          "type": "string",
          "minLength": 1
        },
        "trackId": {
          "type": "string",
          "minLength": 1
        },
        "deck": {
          "type": "integer",
          "minimum": 1
        },
        "sourceStartSeconds": {
          "$ref": "#/$defs/timeSeconds"
        },
        "sourceEndSeconds": {
          "$ref": "#/$defs/timeSeconds"
        },
        "timelineStartSeconds": {
          "$ref": "#/$defs/timeSeconds"
        },
        "timelineEndSeconds": {
          "$ref": "#/$defs/timeSeconds"
        },
        "role": {
          "enum": [
            "primary",
            "incoming",
            "acapella",
            "loop",
            "stem"
          ]
        },
        "tempoPlan": {
          "$ref": "#/$defs/tempoPlan"
        }
      }
    },
    "transitionEdge": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "transitionId",
        "fromPlacementId",
        "toPlacementId",
        "technique",
        "timelineStartSeconds",
        "timelineEndSeconds",
        "score",
        "reasons"
      ],
      "properties": {
        "transitionId": {
          "type": "string",
          "minLength": 1
        },
        "fromPlacementId": {
          "type": "string",
          "minLength": 1
        },
        "toPlacementId": {
          "type": "string",
          "minLength": 1
        },
        "technique": {
          "enum": [
            "intro_outro_blend",
            "build_to_drop_swap",
            "drop_end_reverb_exit",
            "wash_out",
            "loop_tighten",
            "vocal_over_instrumental",
            "echo_out",
            "hard_cut"
          ]
        },
        "timelineStartSeconds": {
          "$ref": "#/$defs/timeSeconds"
        },
        "timelineEndSeconds": {
          "$ref": "#/$defs/timeSeconds"
        },
        "score": {
          "$ref": "#/$defs/confidence"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "riskFlags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "templateId": {
          "type": "string",
          "minLength": 1
        },
        "measureCountToTarget": {
          "type": "number",
          "minimum": 0
        },
        "alignedDropTimelineSeconds": {
          "$ref": "#/$defs/timeSeconds"
        },
        "handoffTimelineSeconds": {
          "$ref": "#/$defs/timeSeconds"
        },
        "sourceAnchors": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/transitionAnchor"
          }
        },
        "tempoPlan": {
          "$ref": "#/$defs/tempoPlan"
        }
      }
    },
    "transitionAnchor": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "trackId": {
          "type": "string",
          "minLength": 1
        },
        "sectionId": {
          "type": "string",
          "minLength": 1
        },
        "cueId": {
          "type": "string",
          "minLength": 1
        },
        "sourceSeconds": {
          "$ref": "#/$defs/timeSeconds"
        },
        "beatIndex": {
          "type": "integer",
          "minimum": 0
        },
        "measureIndex": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "deckCommand": {
      "oneOf": [
        {
          "$ref": "#/$defs/loadCommand"
        },
        {
          "$ref": "#/$defs/playCommand"
        },
        {
          "$ref": "#/$defs/stopCommand"
        },
        {
          "$ref": "#/$defs/seekCommand"
        },
        {
          "$ref": "#/$defs/loopCommand"
        },
        {
          "$ref": "#/$defs/clearLoopCommand"
        },
        {
          "$ref": "#/$defs/automationCommand"
        }
      ]
    },
    "loadCommand": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "at",
        "deck",
        "trackId",
        "cueSeconds"
      ],
      "properties": {
        "type": {
          "const": "load"
        },
        "at": {
          "$ref": "#/$defs/timeSeconds"
        },
        "deck": {
          "type": "integer",
          "minimum": 1
        },
        "trackId": {
          "type": "string",
          "minLength": 1
        },
        "stem": {
          "enum": [
            "full",
            "vocals",
            "drums",
            "bass",
            "other",
            "instrumental"
          ]
        },
        "cueSeconds": {
          "$ref": "#/$defs/timeSeconds"
        }
      }
    },
    "playCommand": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "at",
        "deck"
      ],
      "properties": {
        "type": {
          "const": "play"
        },
        "at": {
          "$ref": "#/$defs/timeSeconds"
        },
        "deck": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "stopCommand": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "at",
        "deck"
      ],
      "properties": {
        "type": {
          "const": "stop"
        },
        "at": {
          "$ref": "#/$defs/timeSeconds"
        },
        "deck": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "seekCommand": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "at",
        "deck",
        "toSeconds"
      ],
      "properties": {
        "type": {
          "const": "seek"
        },
        "at": {
          "$ref": "#/$defs/timeSeconds"
        },
        "deck": {
          "type": "integer",
          "minimum": 1
        },
        "toSeconds": {
          "$ref": "#/$defs/timeSeconds"
        }
      }
    },
    "loopCommand": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "at",
        "deck",
        "startSeconds",
        "lengthBeats"
      ],
      "properties": {
        "type": {
          "const": "setLoop"
        },
        "at": {
          "$ref": "#/$defs/timeSeconds"
        },
        "deck": {
          "type": "integer",
          "minimum": 1
        },
        "startSeconds": {
          "$ref": "#/$defs/timeSeconds"
        },
        "lengthBeats": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "clearLoopCommand": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "at",
        "deck"
      ],
      "properties": {
        "type": {
          "const": "clearLoop"
        },
        "at": {
          "$ref": "#/$defs/timeSeconds"
        },
        "deck": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "automationCommand": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "control",
        "keyframes"
      ],
      "properties": {
        "type": {
          "const": "automate"
        },
        "deck": {
          "type": "integer",
          "minimum": 1
        },
        "control": {
          "enum": [
            "volume",
            "eqLow",
            "eqMid",
            "eqHigh",
            "filter",
            "reverbWet",
            "reverbTailGain",
            "reverbDecaySeconds",
            "echoWet",
            "tempo",
            "crossfader"
          ]
        },
        "postFader": {
          "type": "boolean"
        },
        "effectParameters": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              }
            ]
          }
        },
        "keyframes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/keyframe"
          }
        }
      }
    },
    "keyframe": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "at",
        "value"
      ],
      "properties": {
        "at": {
          "$ref": "#/$defs/timeSeconds"
        },
        "value": {
          "type": "number"
        },
        "interpolation": {
          "enum": [
            "hold",
            "linear",
            "smoothstep",
            "exponential"
          ]
        }
      }
    },
    "planAnnotation": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "at",
        "message"
      ],
      "properties": {
        "at": {
          "$ref": "#/$defs/timeSeconds"
        },
        "placementId": {
          "type": "string"
        },
        "transitionId": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
